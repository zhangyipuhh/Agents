# -*- coding:utf-8 -*-
# DevOps SSH 服务器配置模板
#
# 作用：
#   * 由后端 DevOpsServerService.scan_and_upsert() 扫描并加密入库到 devops_servers 表；
#   * 前端 /api/admin/devops-servers 接口只回显脱敏字段（id / business_name /
#     server_type / updated_at），不会返回本文件中的 IP、用户名、密码、黑白名单、巡检脚本。
#   * 实际配置应复制本文件为 servers.yaml（git-ignored），不要把生产凭据提交到仓库。
#
# 必填字段：
#   * business_name：业务唯一标识，全局唯一；同一文件重复出现 → 该条目记 failed 不入库。
#   * ip           ：目标主机 IP（也兼容旧字段名 host）。
#   * port         ：SSH 端口（1-65535，默认 22）。
#   * username     ：登录用户名。
#   * password     ：明文密码；scan_and_upsert 时由 DEVOPS_CREDENTIAL_KEY（Fernet 密钥）
#                    加密后落库为 BYTEA；明文密码仅在内存中存在，绝不写入日志 / HTTP 响应。
#   * server_type  ：'linux' 或 'windows'（其他值记 failed）。
#
# 可选字段：
#   * blacklist       (list[str])：黑名单，优先级最高；命中即拒绝。
#   * whitelist       (list[str])：强白名单；空白名单时所有非黑名单命令被拒绝。
#                                 匹配模式：精确匹配 / 以空格结尾的前缀匹配 / 以 ^ 开头的正则匹配。
#   * inspection_script_name (str)：巡检脚本库引用（2026-08-03 新增）。
#                                 引用 ``data/devops/inspection_scripts.yaml`` 中的
#                                 条目 name（如 linux-bash / windows-ps-5.1 /
#                                 windows-ps-7+）；省略时按 server_type 走默认匹配
#                                 （linux → linux-bash，windows → windows-ps-5.1）。
#                                 显式指定但脚本库中不存在 → 该条目记 failed 不入库。
#
# 2026-08-03 改造：原 inspection_script / inspection_parser / inspection_fields 三列
# 已从 devops_servers 表移除，由 inspection_scripts 脚本库统一管理。服务器节点仅
# 保留 inspection_script_id 外键。脚本原文 / 解析器 / 字段规则改走
# POST /api/admin/inspection-scripts/scan 扫描入库。
#
# 触发方式：
#   * 在「定时任务管理」->「服务器扫描入库」Tab 点击「立即扫描」；
#   * 或调用 POST /api/admin/devops-servers/scan（admin 鉴权）。
#
# 字段别名（兼容老 YAML）：
#   * business_name ↔ name
#   * ip ↔ host

servers:
  # ===== Linux 巡检服务器示例 =====
  - business_name: dev-linux-01
    ip: 192.0.2.10
    port: 22
    username: ops
    password: "REPLACE_ME"
    server_type: linux
    blacklist:
      - "rm -rf "         # 前缀匹配：拦截所有 rm -rf 开头的命令
      - "shutdown "       # 前缀匹配：拦截 shutdown / shutdown -h / shutdown -r 等
    whitelist:
      - "systemctl status "  # 前缀匹配：允许 systemctl status xxx
      - "df -h"              # 精确匹配：仅允许 df -h（不允许 df -i / df -T 等变体）
      - "tail "              # 前缀匹配：允许 tail -n 100 /var/log/syslog 等
    # 固定巡检脚本（2026-08-03 改造）：服务器节点不再携带脚本原文，
    # 改为通过 inspection_script_name 引用 ``data/devops/inspection_scripts.yaml`` 条目。
    # 这里省略 → 按 server_type 走默认匹配（linux → linux-bash）。
    inspection_script_name: linux-bash

  # ===== Windows 巡检服务器示例 =====
  - business_name: dev-windows-01
    ip: 198.51.100.20
    port: 22
    username: administrator
    password: "REPLACE_ME"
    server_type: windows
    blacklist:
      - "Remove-Item "    # 前缀匹配：拦截所有 Remove-Item 开头的命令（含 -Recurse / -Force）
      - "Stop-Service "   # 前缀匹配：拦截 Stop-Service xxx
      - "Start-Service "  # 前缀匹配：禁止通过白名单外启停服务
      - "Set-Service "    # 前缀匹配：禁止改服务配置
      - "Restart-Service " # 前缀匹配：禁止重启服务
      # IIS appcmd.exe 写 / 启停 / 删除 / 备份还原子命令（白名单只放行 list 子命令）
      - "appcmd add "     # 拦截 appcmd add site / add apppool / add app / add vdir
      - "appcmd set "     # 拦截 appcmd set site / set config / set apppool
      - "appcmd delete "  # 拦截 appcmd delete site / delete apppool
      - "appcmd start "   # 拦截 appcmd start site / apppool
      - "appcmd stop "    # 拦截 appcmd stop site / apppool
      - "appcmd recycle " # 拦截 appcmd recycle apppool
      - "appcmd restore " # 拦截 appcmd restore backup（避免回滚覆盖）
      - "appcmd uninstall " # 拦截 appcmd uninstall（移除组件）
    whitelist:
      - "Get-Service"     # 精确匹配：仅允许 Get-Service（不允许 Get-Service | Format-List 等组合）
      - "Get-WinEvent "   # 前缀匹配：允许 Get-WinEvent -LogName System -MaxEvents 100 等
      # 2026-07-27 新增：IIS / FTP 旧版通用只读命令（兼容 PowerShell 5.1，避免依赖 WebAdministration 模块）
      - "Get-WmiObject"   # 精确匹配：Win32_Service / Win32_PerfRawData_W3SVC_WebService / Win32_PerfRawData_FtpService
      - "Get-Process"     # 精确匹配：兜底查询 w3wp / ftpsvc 工作进程
      - "Select-Object"   # 精确匹配：管道字段选择
      - "Where-Object"    # 精确匹配：管道过滤
      - "Format-Table"    # 精确匹配
      - "Format-List"     # 精确匹配
      - "Out-String"      # 精确匹配
      - "appcmd list "    # 前缀匹配：IIS 7+ list 子命令
      - "%systemroot%\\system32\\inetsrv\\appcmd.exe list "  # 前缀匹配：兼容完整路径调用
      # 2026-07-27 反馈新增：放行 PowerShell 外壳前缀（运维 LLM 习惯用 powershell -Command 形式）
      - "powershell -Command "  # 前缀匹配
      - "powershell -EncodedCommand "  # 前缀匹配（SSHTools 实际包装形式）
    # 固定巡检脚本（2026-08-03 改造）：服务器节点不再携带脚本原文，
    # 改为通过 inspection_script_name 引用 ``data/devops/inspection_scripts.yaml`` 条目。
    # 这里省略 → 按 server_type 走默认匹配（windows → windows-ps-5.1）。
    inspection_script_name: windows-ps-5.1