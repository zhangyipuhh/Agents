#==============================================
# 大模型配置 - 通用模型
#==============================================
# 模型类型：支持 openai, deepseek, ollama 等
model_type="openai"

# 模型名称：根据 model_type 选择对应的模型
# OpenAI: gpt-4, gpt-3.5-turbo
# DeepSeek: deepseek-chat, deepseek-coder
# Ollama: qwen3-vl:30b, llama3.2
model_name="your_model_name_here"

# API 密钥：用于访问远程模型服务
model_api_key="your_api_key_here"

# API 基础 URL：模型服务的地址
# OpenAI: https://api.openai.com/v1
# DeepSeek: https://api.deepseek.com
# Moonshot: https://api.moonshot.cn/v1
# Ollama: http://localhost:11434
model_api_base="your_api_base_url_here"

# 模型温度参数：控制生成多样性
# 取值范围：0.0 - 2.0
# 0.0: 最确定性，适合事实性任务
# 1.0: 平衡，适合一般对话
# 2.0: 最随机，适合创意任务
model_temperature=0.2

# 是否开启多模态：支持同时处理文本和图片
# true: 开启多模态（需要模型支持）
# false: 仅文本模式
is_multimodal="true"

# 是否启用并行工具调用
# none: 不传参（兼容所有模型，推荐）
# true: 启用并行工具调用
# false: 禁用并行工具调用
parallel_tool_calls=none

# Ollama 模型配置（仅对 Ollama 模型有效）
# 是否启用推理功能：true/false
ollama_reasoning=true
# 请求超时时间（秒）
ollama_timeout=120

#==============================================
# 大模型配置 - 视觉模型
#==============================================
# 视觉模型类型
model_type_vision="openai"

# 视觉模型名称（需要支持视觉输入的模型）
# OpenAI: gpt-4-vision-preview, gpt-4o
# Moonshot: moonshot-v1-8k-vision-preview, moonshot-v1-32k-vision-preview
model_name_vision="your_vision_model_name_here"

# 视觉模型 API 密钥
model_api_key_vision="your_vision_api_key_here"

# 视觉模型 API 基础 URL
model_api_base_vision="your_vision_api_base_url_here"

# 视觉模型温度参数
model_temperature_vision=0.2

#==============================================
# Word 输出配置
#==============================================
# 高亮颜色：十六进制格式
# FF0000: 红色
# 00FF00: 绿色
# 0000FF: 蓝色
# FFFF00: 黄色
highlight_color="FF0000"

# 输出目录：Word 文档输出路径
output_dir="app/agents/data/output"

#==============================================
# MapAgent MCP 工具标签过滤
#==============================================
# JSON 数组格式，如: '["map", "geo"]'
map_mcp_tags='["map", "geo"]'

#==============================================
# 配置示例
#==============================================
# 示例 1: DeepSeek 配置
# model_type="deepseek"
# model_name="deepseek-chat"
# model_api_key="sk-your-deepseek-api-key"
# model_api_base="https://api.deepseek.com"
# model_temperature=0.2
# is_multimodal="false"

# 示例 2: Ollama 本地模型配置
# model_type="ollama"
# model_name="qwen3-vl:30b"
# model_api_key="not_required"
# model_api_base="http://localhost:11434"
# model_temperature=0.2
# is_multimodal="true"

# 示例 3: Moonshot 视觉模型配置
# model_type_vision="openai"
# model_name_vision="moonshot-v1-8k-vision-preview"
# model_api_key_vision="sk-your-moonshot-api-key"
# model_api_base_vision="https://api.moonshot.cn/v1"
# model_temperature_vision=0.2

#==============================================
# 文件解析配置
#==============================================
# 是否启用远程文件解析服务（如 MinerU）
# true: 启用远程解析，使用 FileParserClient
# false: 使用本地 DocumentLoader 解析
file_parser_enabled="false"

# 远程解析服务地址
file_parser_server_url="http://mineru-openai-server:30000"

# 输出格式：json 或 md
# json: 解析结果存储为 .json 文件
# md: 解析结果存储为 .md 文件
file_parser_output_format="json"

# 远程解析允许的最大文件大小（MB），前端校验 + 后端校验共用，默认 3
file_parser_max_file_size="3"

# 解析服务 API 地址
file_parser_api_url="/api/v1/parse"

# 最大轮询重试次数
file_parser_max_retries=60

# 轮询间隔（秒）
file_parser_poll_interval=2.0

# 请求超时时间（秒）
file_parser_timeout=300

# 数据库配置
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/feature_agent
AUTH_STORAGE_MODE=postgres
#web api 目标地址
VITE_API_TARGET=http://localhost:8003
#----------------------------------------------
# 演示测试配置
#----------------------------------------------
# ---演示报告生成配置,为true时开启演示报告生成
#----------------------------------------------
demonstration_report_enabled="true"
#==============================================
# Sandbox 沙箱配置
#==============================================
# Docker 部署模式：local / socket / dind / k8s
# local:  本地直接跑（应用进程 = 宿主机），路径无需投影
# socket: 应用容器挂载宿主机 /var/run/docker.sock，路径需通过 host_workspace_prefix 投影
# dind:   Docker-in-Docker（应用容器内嵌 daemon）
# k8s:    通过 K8s API 创建 Pod（占位，未实现）
sandbox_docker_mode="local"

# Docker daemon URL，socket 模式必填，例如 unix:///var/run/docker.sock
sandbox_docker_host=""

# 沙箱镜像名
sandbox_image="python:3.12-alpine"

# 容器内存限制（MB），默认 512
sandbox_max_memory_mb=512

# 容器 CPU 限制（百分比），默认 100
sandbox_max_cpu_percent=100

# 是否启用容器网络，默认 false
sandbox_network_enabled="false"

# 命令默认超时（秒），默认 60
sandbox_default_timeout=60

# 容器内工作目录（bind mount target），默认 /workspace
sandbox_container_workspace="/workspace"

# 宿主机视角工作目录前缀，socket 模式必填
sandbox_host_workspace_prefix=""

# Docker 不可用时是否降级到本地文件系统执行
# true:  使用 LocalShellBackend 在本地 workspace 继续运行（失去 Docker 隔离，仅限开发/可信环境）
# false: 仅返回清晰错误，保持安全边界（默认）
sandbox_fallback_to_local="false"

#==============================================
# 飞书 Open API 配置
#==============================================
# 飞书应用 App ID（在飞书开放平台 > 应用详情获取）
feishu_app_id=""
# 飞书应用 App Secret
feishu_app_secret=""
# 默认接收方 ID（如群 chat_id: oc_xxx；用户 open_id: ou_xxx）
feishu_default_receive_id=""
# 默认接收方类型：chat_id / open_id / user_id / email
feishu_default_receive_id_type="chat_id"
# SDK 日志级别：DEBUG / INFO / WARNING / ERROR
feishu_log_level="INFO"

# 是否启用飞书 WebSocket 长连接接收消息（默认关闭）
# 启用后需在飞书后台配置事件订阅 im.message.receive_v1（订阅类型选 WebSocket）
# 会话范围：私聊（p2p）全部回复 + 群聊仅 @机器人 回复
feishu_ws_enabled="false"
# 飞书消息路由到的目标智能体名称（默认 project）
feishu_ws_agent_name="project"
# 飞书会话归属的系统用户名（默认 feishu_bot，2026-07-17 新增）
# 该用户必须预先在系统中存在（通过注册接口或 seed 创建）;
# lifespan 启动时按用户名查 user_id,用户不存在则 ERROR 日志并跳过 WS 服务启动。
# 前端以该账号登录后,/api/session/list 可看到所有飞书产生的会话。
feishu_ws_receiver_username="feishu_bot"

# 飞书 CardKit 卡片流式/节流配置（2026-07-19 新增）
# 是否启用元素级流式更新：true(默认) / false；false 时回退到整卡更新
feishu_card_streaming_enabled="true"
# 流式打印频率（毫秒），默认 70
feishu_card_streaming_print_frequency_ms=70
# 流式打印步长（字符数），默认 1
feishu_card_streaming_print_step=1
# 流式打印策略，默认 fast
feishu_card_streaming_print_strategy="fast"
# 卡片更新最小时间间隔（毫秒），默认 600
feishu_card_update_interval_ms=600
# 卡片更新最小字符增量，默认 50
feishu_card_update_delta_chars=50

#==============================================
# 邮件系统配置
#==============================================
# 邮件系统总开关：false 时 lifespan 跳过 EmailConfigService 挂载，
# /api/admin/email/* 接口返回 500（EmailConfigService not initialized）。
# 默认 true；只有在不需要邮件通知的场景才置 false。
EMAIL_ENABLED=true
# 共享 Fernet 密钥（与 DevOps 共用 DEVOPS_CREDENTIAL_KEY）。
# 留空 → EmailConfigService 跳过初始化 + /server-config/test 路由降级。
# SMTP 主机/端口/账号/授权码本身通过 Web 管理界面在「邮件设置 → 服务器配置」页维护，
# 持久化到 email_server_configs 表（password_encrypted 字段使用本密钥 Fernet 加密）。

#==============================================
# DevOps SSH 服务器配置（2026-07-15 新增）
#==============================================
# Fernet 对称密钥，用于加解密 devops_servers.password_encrypted 字段。
# 必须由 Fernet.generate_key() 生成（44 字节 url-safe base64）。
# 生成命令：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 留空时 lifespan 会跳过 DevOpsServerService 挂载，admin API 返回 500 + hint。
DEVOPS_CREDENTIAL_KEY=""
# 可选：servers.yaml 路径（默认 <项目根>/data/devops/servers.yaml）
# DEVOPS_SERVERS_CONFIG_PATH=data/devops/servers.yaml

#==============================================
# 第三方命令执行器配置（2026-08-03 新增）
#==============================================
# 当 SSHTools.execute_command 的 runtime.context["use_third_party_executor"]=True 时，
# 后端会把命令打包为 RSA-OAEP + AES-256-GCM 加密的请求体，HTTPS 调用以下端点执行。
# 响应目前为明文（v1 契约）；如未来启用双向加密，需要再提供一个响应方公钥。
#
# 端点 JSON 配置（数组），每项字段：
#   name            端点唯一标识，对应 runtime.context["third_party_endpoint_name"]
#   url             HTTPS 接口地址（必须 https://，启动期校验）
#   public_key_pem  第三方提供的 RSA 公钥（PEM），用于加密请求体
#   timeout_seconds HTTP 调用超时（1~300 秒，默认 30）
#   enabled         true/false（默认 true），false 时该端点不可用
#
# 完整对接规范见 .trae/documents/第三方接口对接规范.md
# THIRD_PARTY_EXECUTOR_ENDPOINTS='[
#   {
#     "name": "primary",
#     "url": "https://third-party.example.com/api/v1/exec",
#     "public_key_pem": "-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...\n-----END PUBLIC KEY-----",
#     "timeout_seconds": 60,
#     "enabled": true
#   }
# ]'
THIRD_PARTY_EXECUTOR_ENDPOINTS=""
# 默认端点名（runtime.context["third_party_endpoint_name"] 缺省时使用）
THIRD_PARTY_EXECUTOR_DEFAULT_ENDPOINT="primary"
# 是否允许 http:// 端点（关闭 HTTPS 强制校验，2026-08-03 新增）。
# **仅供开发 / 测试 / 内网环境使用**；生产环境务必保持 false，否则请求体
# 加密失去传输层保护（中间人仍可截获密文并篡改或重放）。
# 开启后仍保留请求体加密（RSA-OAEP + AES-256-GCM）；只是不再校验 TLS。
THIRD_PARTY_EXECUTOR_ALLOW_INSECURE="false"

# ------------------------------------------------------------------------------
# 业务方启用方式（2026-08-03）
# ------------------------------------------------------------------------------
# 在 AgentContext.context_overrides 注入以下字段即可让 SSHTools.execute_command
# 走第三方 HTTPS（加密请求体）而不是本地 Paramiko SSH：
#
#   runtime.context = {
#       "use_third_party_executor": True,                       # 必填：开关
#       "third_party_endpoint_name": "primary",                  # 可选：覆盖默认端点
#   }
#
# 缺省 / False 时，execute_command 走本地 Paramiko（向后兼容，行为不变）。
# 仅 execute_command 受影响；execute_batch_commands / get_system_logs 暂不改造。
# AgentContext TypedDict 中已显式声明这两个字段。

#==============================================
# MFA 双因素认证配置（2026-08-08 新增）
#==============================================
# 浏览器 /login 双因素认证（TOTP）的 Fernet 对称密钥。
# 缺失或非法时 lifespan 无法初始化 MfaService，登录将 fail-closed 返回 503。
# 必须由 Fernet.generate_key() 生成（44 字节 url-safe base64）。
# PowerShell 生成方式：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode('ascii'))"
# 生成后复制输出值填入下方（不要加引号，不要包含换行）。
# MFA issuer：Microsoft Authenticator 等认证器中显示的应用名称，可按部署需要覆盖
MFA_ISSUER="AIOps"
MFA_SECRET_KEY=""

#==============================================
# 认证 Cookie 配置（等保三级-数据保密性，2026-08-08 落地）
#==============================================
# Access Token / Refresh Token HttpOnly Cookie 的 Secure 标志。
# 值为字符串 "true"/"false"（pydantic-settings 自动 boolean 解析）。
# 生产 HTTPS 环境必须置 true（防止 Cookie 在 HTTP 明文上泄露）；
# 本地 HTTP 开发保持 false（绝大多数开发环境无 HTTPS，否则浏览器直接拒发 Cookie）。
# AuthCookieSettings 完整字段见 app/core/config/settings.py（AUTH_COOKIE_ 前缀）。
AUTH_COOKIE_SECURE=false

#==============================================
# 认证初始化配置（等保三级-身份鉴别 1.2，2026-08-09 新增）
#==============================================
# bootstrap 开关：仅在第一次部署或历史 admin 账号使用 admin123/123456 时开启；
# 启用时必须同时设置 AUTH_DEFAULT_ADMIN_PASSWORD 且口令需通过复杂度校验否则启动时抛 ValueError / RuntimeError 拒绝启动。
AUTH_BOOTSTRAP_ENABLED=false
AUTH_DEFAULT_ADMIN_USERNAME=admin
# 满足 length>=8 + 大写 + 小写 + 数字 + 特殊字符；不要使用 admin123/123456。
AUTH_DEFAULT_ADMIN_PASSWORD=""
# 同一账号最大并发会话数（>=1）；新登录会踢出最旧会话，仅保留最近 N-1 条
AUTH_MAX_CONCURRENT_SESSIONS=5n

CONTRACT_LLM_MODEL_NAME="qwen3:32b"
CONTRACT_LLM_MODEL_TYPE="ollama"    
CONTRACT_LLM_MODEL_API_KEY= "11111"
CONTRACT_LLM_MODEL_API_BASE="http://192.168.1.100:11434"
# 2026-08-20 新增：合同路由专属并行工具调用开关。
# 取值 false / true / none（字符串），与 ContractLLMSettings._parse_parallel_tool_calls 一致。
# 重要：当 CONTRACT_LLM_MODEL_NAME 非空时本字段不读全局 parallel_tool_calls，必须显式声明。
# Ollama 场景下不显式传 false 会触发多 tool 并行写 file_chunk_read_progress 的
# LangGraph InvalidUpdateError（Can receive only one value per step）。
CONTRACT_LLM_PARALLEL_TOOL_CALLS=false
